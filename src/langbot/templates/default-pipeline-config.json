{
    "trigger": {
        "group-respond-rules": {
            "at": true,
            "prefix": [
                "ai"
            ],
            "regexp": [],
            "random": 0.0
        },
        "access-control": {
            "mode": "blacklist",
            "blacklist": [],
            "whitelist": []
        },
        "ignore-rules": {
            "prefix": [],
            "regexp": []
        },
        "message-aggregation": {
            "enabled": false,
            "delay": 1.5
        },
        "misc": {
            "combine-quote-message": true
        }
    },
    "safety": {
        "content-filter": {
            "scope": "all",
            "check-sensitive-words": true
        },
        "rate-limit": {
            "window-length": 60,
            "limitation": 60,
            "strategy": "drop"
        }
    },
    "ai": {
        "runner": {
            "runner": "local-agent"
        },
        "local-agent": {
            "model": {
                "primary": "",
                "fallbacks": []
            },
            "max-round": 10,
            "application-settings": "你是【传奇手游】企微专属智能客服，聚焦老玩家召回+新游推介核心场景。严格参照知识库内容，同一问题随机选取 1 个答案回复，版本匹配精准，不混淆下载链接。主动问候时优先关联玩家过往游戏经历，自然推介匹配版本和下载指引。保持回复简洁亲切，不要太长，暂时不要推送复古版本内容。遇到职业排行、氪度对比、礼包码、新区时间、下载失败、注册异常、负面质疑、要求人工、提交区服角色名、旧账号复杂问题等场景时，优先按当前客服人设自然接话，先确认收到、安抚或补问一个关键问题，不要直接说转人工。知识库暂未覆盖时，不要编造具体活动规则、数值或结果承诺；但寒暄、确认收到、角色化接话这类非事实性回复，可以按当前客服人设自然表达。执行敏感词双重过滤，并把“福利”统一替换成“福～利”。",
            "application-description": "企微传奇老玩家召回与新游推荐客服",
            "opening-intro": "老板你好呀！专属新游福～利来啦🎁 这款适配老玩家的新传奇，不仅贴合你之前的游戏喜好，还能领取传奇老玩家专属登录礼，解锁专属装备。现邀请老玩家回归体验。要不要一起冲新服？",
            "show-advanced-prompt": false,
            "prompt": [
                {
                    "role": "system",
                    "content": "你是【传奇手游】企微专属智能客服，聚焦老玩家召回、新游推介、版本匹配、下载指引四类场景。严格优先依据知识库回复，不要脱离知识库编造具体活动规则、数值或结果承诺；同一问题若有多个候选答案，任选 1 个输出，并尽量避免同会话重复。语气活泼亲切、简洁自然，不要太长，不要生硬营销。优先围绕玩家过往游戏经历和偏好版本推荐内容，暂不主动推送复古版本。单职业无限刀版本推荐御龙无双：https://g.guayou.com/?ct=shouyou&ac=h5&gid=63&member=639；超变版本推荐战谷：https://g.guayou.com/?ct=shouyou&ac=h5&gid=68&member=217。发送下载链接时，先说明版本适配，再在结尾追加：麻烦老板按区服：XX区 角色名：XXX的格式发送给我。不要频繁补充下载指引。若玩家明确表示不需要咨询或不下载，礼貌结束，不再继续推介。若触发人工介入、高意向深度咨询、攻略排行、氪度对比、礼包码、新区时间、下载注册障碍、负面质疑、要求人工、提交区服角色名、旧账号复杂问题等场景，先按当前客服人设自然接话，优先安抚、确认收到或补问一个最关键的信息，不要直接说转人工。对寒暄、确认收到、角色化接话这类非事实性回复，可以按当前客服人设自然表达。始终执行敏感词过滤，并将“福利”统一替换为“福～利”。首次主动问候可参考：老板你好呀！专属新游福～利来啦🎁 这款适配老玩家的新传奇，不仅贴合你之前的游戏喜好，还能领取传奇老玩家专属登录礼，解锁专属装备。现邀请老玩家回归体验。要不要一起冲新服？"
                }
            ],
            "knowledge-bases": []
        },
        "dify-service-api": {
            "base-url": "https://api.dify.ai/v1",
            "app-type": "chat",
            "api-key": "your-api-key",
            "timeout": 30
        },
        "dashscope-app-api": {
            "app-type": "agent",
            "api-key": "your-api-key",
            "app-id": "your-app-id",
            "references-quote": "参考资料来自:"
        },
        "n8n-service-api": {
            "webhook-url": "http://your-n8n-webhook-url",
            "auth-type": "none",
            "basic-username": "",
            "basic-password": "",
            "jwt-secret": "",
            "jwt-algorithm": "HS256",
            "header-name": "",
            "header-value": "",
            "timeout": 120,
            "output-key": "response"
        },
        "langflow-api": {
            "base-url": "http://localhost:7860",
            "api-key": "your-api-key",
            "flow-id": "your-flow-id",
            "input-type": "chat",
            "output-type": "chat",
            "tweaks": "{}"
        }
    },
    "output": {
        "long-text-processing": {
            "threshold": 1000,
            "strategy": "none",
            "font-path": ""
        },
        "force-delay": {
            "min": 0,
            "max": 0
        },
        "misc": {
            "exception-handling": "show-hint",
            "failure-hint": "Request failed.",
            "at-sender": true,
            "quote-origin": true,
            "track-function-calls": false,
            "remove-think": false
        }
    }
}
